{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "N3 Blender Export Receipt v1",
  "description": "Metadata written beside mod.toml for a constrained N3 Blender export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modId",
    "target",
    "producer",
    "exports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modId": {
      "$ref": "#/$defs/modId"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titleId",
        "mediaId",
        "version",
        "xexSha256"
      ],
      "properties": {
        "titleId": {
          "const": "4D5307DB"
        },
        "mediaId": {
          "const": "5D48689C"
        },
        "version": {
          "const": "0.0.0.3"
        },
        "xexSha256": {
          "const": "0fe8973b6ff45d3f8bd03a51a8c0d8cdf278b3d43e793497777e075f4e94a804"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "blenderVersion"
      ],
      "properties": {
        "id": {
          "const": "n3-blender"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$"
        },
        "blenderVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/export"
      }
    }
  },
  "$defs": {
    "modId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gamePath": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^data/(?:[^/\\\\\\u0000-\\u001f]+/)*[^/\\\\\\u0000-\\u001f]+$",
      "not": {
        "pattern": "(?:^|/)\\.\\.?(?:/|$)"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/gamePath"
        },
        "role": {
          "enum": [
            "model",
            "skin",
            "texture",
            "effect",
            "other"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "profile",
        "sourceFiles",
        "outputFiles",
        "capabilities",
        "preservation",
        "validation",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "loose-model-set",
            "texture"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "outputFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "preservation": {
          "enum": [
            "byte-identical",
            "opaque-sections-preserved",
            "fully-reencoded"
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceParse",
            "unmodifiedRoundTrip",
            "outputReparse"
          ],
          "properties": {
            "sourceParse": {
              "const": "complete"
            },
            "unmodifiedRoundTrip": {
              "enum": [
                "byte-identical",
                "not-applicable"
              ]
            },
            "outputReparse": {
              "const": "complete"
            }
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
