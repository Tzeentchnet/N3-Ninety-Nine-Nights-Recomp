+REX_TEST_CASE("Protecting a physical alias leaves the raw GPU view writable", "[kernel][mmio]") {
+  auto& memory = rex::test::GetTestMemory();
+  constexpr rex::u32 kPageSize = 0x1000;
+  const rex::u32 address =
+      memory.SystemHeapAlloc(kPageSize, kPageSize, rex::kernel::kSystemHeapPhysical);
+  REQUIRE(address != 0);
+  rex::kernel::BaseHeap* heap = memory.LookupHeap(address);
+  REQUIRE(heap != nullptr);
+  const rex::ScopeGuard cleanup([&] {
+    heap->Protect(address, kPageSize,
+                  rex::kernel::kMemoryProtectRead | rex::kernel::kMemoryProtectWrite);
+    memory.SystemHeapFree(address);
+  });
+
+  rex::u8* const alias = memory.TranslateVirtual(address);
+  rex::u8* const raw = memory.TranslatePhysical(memory.GetPhysicalAddress(address));
+  REQUIRE(heap->Protect(address, kPageSize, rex::kernel::kMemoryProtectRead));
+
+  size_t length = kPageSize;
+  rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+  REQUIRE(rex::memory::QueryProtect(alias, length, access));
+  CHECK(access == rex::memory::PageAccess::kReadOnly);
+  length = kPageSize;
+  REQUIRE(rex::memory::QueryProtect(raw, length, access));
+  CHECK(access == rex::memory::PageAccess::kReadWrite);
+}
+
+REX_TEST_CASE("Allocating a protected physical alias leaves the raw GPU view writable",
+              "[kernel][mmio]") {
+  auto& memory = rex::test::GetTestMemory();
+  constexpr rex::u32 kPageSize = 0x1000;
+  rex::kernel::BaseHeap* heap = memory.LookupHeapByType(true, kPageSize);
+  REQUIRE(heap != nullptr);
+  rex::u32 address = 0;
+  REQUIRE(heap->Alloc(
+      kPageSize, kPageSize,
+      rex::kernel::kMemoryAllocationReserve | rex::kernel::kMemoryAllocationCommit,
+      rex::kernel::kMemoryProtectRead, false, &address));
+  const rex::ScopeGuard cleanup([&] { heap->Release(address); });
+
+  rex::u8* const alias = memory.TranslateVirtual(address);
+  rex::u8* const raw = memory.TranslatePhysical(memory.GetPhysicalAddress(address));
+  size_t length = kPageSize;
+  rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+  REQUIRE(rex::memory::QueryProtect(alias, length, access));
+  CHECK(access == rex::memory::PageAccess::kReadOnly);
+  length = kPageSize;
+  REQUIRE(rex::memory::QueryProtect(raw, length, access));
+  CHECK(access == rex::memory::PageAccess::kReadWrite);
+}
